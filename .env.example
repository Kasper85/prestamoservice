# Base de datos PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/prestacontrol
DB_USERNAME=postgres
DB_PASSWORD=tu_password_aqui

# JWT (clave en Base64 de al menos 32 bytes; genera una nueva para produccion)
JWT_SECRET=reemplazar_por_clave_base64_de_32_bytes_o_mas
JWT_EXPIRATION_MS=3600000

# Puerto del servidor
PORT=8080
